# /etc/bvl-automations/.lab_monitor.conf -- EXAMPLE. Do not commit the real one.
#
#   sudo cp lab_monitor.conf.example /etc/bvl-automations/.lab_monitor.conf
#   sudo chmod 600 /etc/bvl-automations/.lab_monitor.conf
#
# systemd EnvironmentFile syntax: plain KEY=value, no `export`, no quoting
# unless the value genuinely contains spaces.

# Where the topology lives.
LAB_MONITOR_CONFIG=/etc/bvl-automations/lab_monitor.toml

# Static IPs of the three workstations. Variable names are whatever the TOML's
# `address_env` fields say; no address is ever committed to the repo.
DEEPTHOUGHT_IP=10.0.0.1
GPU2_IP=10.0.0.2
GPU3_IP=10.0.0.3

# The local Netdata Parent that LabMonitor queries.
NETDATA_URL=http://127.0.0.1:19999

# Link at the bottom of every Slack dashboard: however you reach Netdata from
# a browser (VPN, reverse proxy, ssh tunnel). Unset omits the link.
NETDATA_DASHBOARD_URL=http://10.0.0.1:19999

# Slack app credentials (see README, "Slack app configuration").
LAB_MONITOR_SLACK_BOT_TOKEN=xoxb-...
LAB_MONITOR_SLACK_APP_TOKEN=xapp-...
LAB_MONITOR_SLACK_CHANNEL_ID=C01234567
